# Set these in Vercel → Project → Settings → Environment Variables (never commit real values)
ALCHEMY_KEY=
# optional overrides
# ALCHEMY_NETWORK=robinhood-mainnet
# CA=0x...            token contract (defaults to the one in api/mcap.js)
# POOL=0x...          pool address (v2/v3) or pool id (v4) — skips DexScreener pool discovery
# POOL_VERSION=v4     v2 | v3 | v4
# QUOTE=0x0000000000000000000000000000000000000000   quote token (0x0 = native ETH)
# CACHE_SECONDS=5     edge cache window; bounds Alchemy calls to ~1 per window
